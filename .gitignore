# Terraform state files
# WHY: State files contain sensitive infrastructure details including
#      resource IDs, IP addresses, and configuration secrets
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Terraform variable files
# WHY: Contains your real IP address and key pair name
terraform.tfvars

# Terraform working directory
# WHY: Generated by terraform init — contains downloaded provider
#      binaries that do not belong in version control
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json

# Local environment files
.env